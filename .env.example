# Google Cloud configuration for Vertex AI embeddings.
# Copy this file to .env and fill in your own project values.
# .env is git-ignored -- it must never be committed to the repository.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Vertex AI semantic relevance threshold (cosine similarity, 0.0-1.0).
#
# Default 0.6 is calibrated for the FICTIONAL SAMPLE CORPUS in this repository
# using gemini-embedding-001 (global endpoint). It is NOT a universal value.
#
# Observed scores on the sample corpus that informed this default:
#   Password query (relevant)               : 0.7105  -- accepted
#   Annual leave query (relevant)           : 0.6947  -- accepted
#   Synonym query "vacation time" (relevant): 0.7275  -- accepted
#   "Who was Julius Caesar?" (unrelated)    : 0.5092  -- REJECTED
#
# Recalibrate whenever you change the corpus, chunking, or embedding model.
# See README for the full calibration procedure.
VERTEX_MIN_SCORE=0.6
